# Google Search Console — código de verificación por etiqueta HTML.
# Se obtiene en search.google.com/search-console al elegir "Etiqueta HTML".
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Google Analytics 4 — identificador de medición, formato G-XXXXXXXXXX.
# Se obtiene en analytics.google.com → Administrar → Flujos de datos.
NEXT_PUBLIC_GA_ID=

# Google Places API (New) — para mostrar las reseñas reales de la ficha.
# Clave de SERVIDOR (sin prefijo NEXT_PUBLIC_): se crea en
# console.cloud.google.com → APIs y servicios → Credenciales, con la
# "Places API (New)" habilitada y restringida a esa API.
GOOGLE_PLACES_API_KEY=
# Identificador de la ficha del consultorio, formato ChIJ...
# Se obtiene en developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
